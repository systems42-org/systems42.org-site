source "https://rubygems.org"

# Jekyll 4.x. The site is built by GitHub Actions (see .github/workflows/pages.yml),
# not by the legacy github-pages gem, so we are free to use a current Jekyll.
gem "jekyll", "~> 4.4"
gem "jekyll-sass-converter", "~> 3.0"

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

group :test do
  gem "html-proofer"
end

gem "webrick", "~> 1.8"
